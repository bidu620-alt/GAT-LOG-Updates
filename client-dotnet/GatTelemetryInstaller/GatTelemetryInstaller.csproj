<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>GAT_TELEMETRIA_DOTNET_SETUP_1.0.0_TESTE</AssemblyName>
    <RootNamespace>GatTelemetryInstaller</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="All" />
    <EmbeddedResource Include="payload\GAT_TELEMETRIA.exe" LogicalName="payload/GAT_TELEMETRIA.exe" />
    <EmbeddedResource Include="payload\GAT_TELEMETRIA.exe.config" LogicalName="payload/GAT_TELEMETRIA.exe.config" />
    <EmbeddedResource Include="payload\Newtonsoft.Json.dll" LogicalName="payload/Newtonsoft.Json.dll" />
  </ItemGroup>
</Project>
