<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROADLIFE Dashboard2 Green"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True"
        Width="1200"
        Height="297"
        MinWidth="780"
        MinHeight="193"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#80042012"/>
    <SolidColorBrush x:Key="EdgeBrush" Color="#FF36F27A"/>
    <SolidColorBrush x:Key="SoftEdgeBrush" Color="#B836F27A"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#FFB9C1C7"/>
    <SolidColorBrush x:Key="FuelTrackBrush" Color="#5530FF78"/>
    <SolidColorBrush x:Key="FuelFillBrush" Color="#FF4CFF8A"/>

    <Style x:Key="PanelStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SoftEdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="ValueStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
  </Window.Resources>

  <Grid Name="Root" Background="Transparent" Margin="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="2.35*"/>
      <RowDefinition Height="1*"/>
    </Grid.RowDefinitions>

    <!-- LINHA PRINCIPAL: tudo distribuído por frações, sem Canvas e sem Viewbox -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.20*"/>
        <ColumnDefinition Width="2.60*"/>
        <ColumnDefinition Width="0.50*"/>
        <ColumnDefinition Width="1.80*"/>
        <ColumnDefinition Width="0.60*"/>
        <ColumnDefinition Width="3.30*"/>
      </Grid.ColumnDefinitions>

      <!-- ROADLIFE / STATUS -->
      <Border Grid.Column="0" Style="{StaticResource PanelStyle}" CornerRadius="24">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Text="ROADLIFE"
                     Foreground="White"
                     FontWeight="Bold"
                     FontSize="19"
                     HorizontalAlignment="Center"
                     Margin="0,4,0,0"/>

          <TextBlock Grid.Row="1"
                     Text="ETS2"
                     Foreground="White"
                     FontWeight="Bold"
                     FontSize="10"
                     HorizontalAlignment="Center"
                     Margin="0,-2,0,4"/>

          <TextBlock Name="OnlineText"
                     Grid.Row="2"
                     Text="● ONLINE"
                     Foreground="White"
                     FontWeight="Bold"
                     FontSize="14"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     TextAlignment="Center"/>

          <TextBlock Name="DateText"
                     Grid.Row="3"
                     Text="02/10/26"
                     Foreground="White"
                     FontWeight="Bold"
                     FontSize="14"
                     HorizontalAlignment="Center"
                     Margin="0,2"/>

          <TextBlock Name="TimeText"
                     Grid.Row="4"
                     Text="10:40:57"
                     Foreground="White"
                     FontWeight="Bold"
                     FontSize="14"
                     HorizontalAlignment="Center"
                     Margin="0,2,0,4"/>
        </Grid>
      </Border>

      <!-- ROTA + PESO + COMBUSTÍVEL -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="1.30*"/>
          <RowDefinition Height="0.90*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="ROTA ATUAL"
                       Style="{StaticResource CaptionStyle}"
                       HorizontalAlignment="Left"/>

            <TextBlock Name="RouteText"
                       Grid.Row="1"
                       Text="Albacete → A Coruña"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="22"
                       TextAlignment="Center"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="6,0"/>

            <Grid Grid.Row="2" Margin="2,2,2,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <TextBlock Name="StartKmText"
                         Grid.Column="0"
                         Text="0 km"
                         Style="{StaticResource CaptionStyle}"
                         HorizontalAlignment="Left"/>

              <TextBlock Name="RemainKmTop"
                         Grid.Column="1"
                         Text="928 km"
                         Style="{StaticResource CaptionStyle}"
                         HorizontalAlignment="Right"/>
            </Grid>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.85*"/>
            <ColumnDefinition Width="1.15*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0"
                         Text="PESO"
                         Style="{StaticResource CaptionStyle}"
                         HorizontalAlignment="Center"/>

              <TextBlock Name="CargoWeight"
                         Grid.Row="1"
                         Text="22,1 t"
                         Style="{StaticResource ValueStyle}"
                         FontSize="22"
                         HorizontalAlignment="Stretch"/>
            </Grid>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0"
                         Text="COMBUSTÍVEL"
                         Style="{StaticResource CaptionStyle}"
                         HorizontalAlignment="Center"/>

              <TextBlock Name="FuelText"
                         Grid.Row="1"
                         Text="644 / 1.300 L"
                         Style="{StaticResource ValueStyle}"
                         FontSize="16"
                         HorizontalAlignment="Stretch"/>

              <Grid Grid.Row="2" Margin="4,2,4,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Width="125"
                      Height="8"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                  <Border Background="{StaticResource FuelTrackBrush}"
                          CornerRadius="4"/>
                  <Border Name="FuelBar"
                          Width="62"
                          Height="8"
                          HorizontalAlignment="Left"
                          Background="{StaticResource FuelFillBrush}"
                          CornerRadius="4"/>
                </Grid>

                <TextBlock Name="FuelPct"
                           Grid.Column="1"
                           Text="50%"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- TEMPERATURA -->
      <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="5">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Text="TEMP"
                     Style="{StaticResource CaptionStyle}"
                     FontSize="9"
                     HorizontalAlignment="Center"/>

          <TextBlock Name="TempText"
                     Grid.Row="1"
                     Text="53°C"
                     Style="{StaticResource ValueStyle}"
                     FontSize="16"
                     HorizontalAlignment="Stretch"/>
        </Grid>
      </Border>

      <!-- VELOCÍMETRO: o slot cresce, mas a elipse mantém proporção -->
      <Grid Grid.Column="3" Margin="4">
        <Ellipse Fill="{StaticResource PanelBrush}"
                 Stroke="{StaticResource EdgeBrush}"
                 StrokeThickness="1.5"
                 Stretch="Uniform"
                 Margin="3"/>

        <Grid Margin="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Name="SpeedText"
                     Grid.Row="0"
                     Text="0"
                     Foreground="White"
                     FontWeight="Bold"
                     FontSize="67"
                     TextAlignment="Center"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Bottom"/>

          <TextBlock Grid.Row="1"
                     Text="km/h"
                     Foreground="White"
                     FontWeight="Bold"
                     FontSize="17"
                     TextAlignment="Center"
                     HorizontalAlignment="Stretch"
                     Margin="0,-8,0,0"/>

          <TextBlock Name="GearText"
                     Grid.Row="2"
                     Text="D1"
                     Foreground="White"
                     FontWeight="Bold"
                     FontSize="23"
                     TextAlignment="Center"
                     HorizontalAlignment="Stretch"
                     Margin="0,2,0,8"/>
        </Grid>
      </Grid>

      <!-- LIMITE + CRUISE -->
      <Border Grid.Column="4" Style="{StaticResource PanelStyle}" Padding="5">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="1.15*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0.90*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="4">
            <Ellipse Fill="#FFF5F5F5"
                     Stroke="#FFFF3737"
                     StrokeThickness="6"
                     Stretch="Uniform"/>

            <TextBlock Name="LimitText"
                       Text="56"
                       Foreground="#FF111111"
                       FontWeight="Bold"
                       FontSize="25"
                       TextAlignment="Center"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"/>
          </Grid>

          <TextBlock Grid.Row="1"
                     Text="LIMITE"
                     Style="{StaticResource CaptionStyle}"
                     FontSize="8"
                     HorizontalAlignment="Center"
                     Margin="0,1,0,3"/>

          <Grid Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="CRUISE"
                       Style="{StaticResource CaptionStyle}"
                       FontSize="9"
                       HorizontalAlignment="Center"/>

            <TextBlock Name="CruiseText"
                       Grid.Row="1"
                       Text="OFF"
                       Style="{StaticResource ValueStyle}"
                       FontSize="16"
                       HorizontalAlignment="Stretch"/>
          </Grid>
        </Grid>
      </Border>

      <!-- CARGA DINÂMICA -->
      <Border Grid.Column="5" Style="{StaticResource PanelStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.20*"/>
              <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="CARGA DINÂMICA"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="13"
                       HorizontalAlignment="Left"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Grid.Column="1"
                       Text="Reconhecimento automático"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="8"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
          </Grid>

          <Grid Grid.Row="1" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.30*"/>
              <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Image Name="CargoPreview"
                   Grid.Column="0"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Margin="4"/>

            <TextBlock Name="CargoRightName"
                       Grid.Column="1"
                       Text="ARROZ"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="28"
                       TextAlignment="Center"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Margin="8,0"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- BARRA INFERIOR: uma única faixa de ponta a ponta -->
    <Border Grid.Row="1"
            Style="{StaticResource PanelStyle}"
            CornerRadius="16"
            Padding="4">

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.30*"/>
          <ColumnDefinition Width="1.30*"/>
          <ColumnDefinition Width="1.10*"/>
          <ColumnDefinition Width="1.35*"/>
          <ColumnDefinition Width="2.45*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Text="DISTÂNCIA RESTANTE"
                     Style="{StaticResource CaptionStyle}"
                     FontSize="11"
                     HorizontalAlignment="Center"/>

          <TextBlock Name="RemainBottom"
                     Grid.Row="1"
                     Text="928 km"
                     Style="{StaticResource ValueStyle}"
                     FontSize="21"
                     HorizontalAlignment="Stretch"/>
        </Grid>

        <Border Grid.Column="1"
                BorderBrush="#5536F27A"
                BorderThickness="1,0,0,0"
                Padding="8,0,4,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="PERCURSO DA VIAGEM"
                       Style="{StaticResource CaptionStyle}"
                       FontSize="11"
                       HorizontalAlignment="Center"/>

            <TextBlock Name="TravelBottom"
                       Grid.Row="1"
                       Text="927 km"
                       Style="{StaticResource ValueStyle}"
                       FontSize="21"
                       HorizontalAlignment="Stretch"/>
          </Grid>
        </Border>

        <Border Grid.Column="2"
                BorderBrush="#5536F27A"
                BorderThickness="1,0,0,0"
                Padding="8,0,4,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="CHEGADA ESTIMADA"
                       Style="{StaticResource CaptionStyle}"
                       FontSize="11"
                       HorizontalAlignment="Center"/>

            <TextBlock Name="EtaText"
                       Grid.Row="1"
                       Text="11:53"
                       Style="{StaticResource ValueStyle}"
                       FontSize="21"
                       HorizontalAlignment="Stretch"/>
          </Grid>
        </Border>

        <Border Grid.Column="3"
                BorderBrush="#5536F27A"
                BorderThickness="1,0,0,0"
                Padding="8,0,4,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="CAMINHÃO"
                       Style="{StaticResource CaptionStyle}"
                       FontSize="11"
                       HorizontalAlignment="Center"/>

            <TextBlock Name="TruckText"
                       Grid.Row="1"
                       Text="Iveco Stralis"
                       Style="{StaticResource ValueStyle}"
                       FontSize="18"
                       HorizontalAlignment="Stretch"
                       TextTrimming="CharacterEllipsis"/>
          </Grid>
        </Border>

        <Border Grid.Column="4"
                BorderBrush="#5536F27A"
                BorderThickness="1,0,0,0"
                Padding="8,0,4,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="0.80*"/>
              <ColumnDefinition Width="1*"/>
              <ColumnDefinition Width="1*"/>
              <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="DANOS"
                       Style="{StaticResource CaptionStyle}"
                       FontSize="13"
                       HorizontalAlignment="Center"/>

            <Grid Grid.Column="1">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0"
                         Text="Caminhão"
                         Style="{StaticResource CaptionStyle}"
                         FontSize="10"
                         HorizontalAlignment="Center"/>
              <TextBlock Name="TruckDamageText"
                         Grid.Row="1"
                         Text="0,0%"
                         Style="{StaticResource ValueStyle}"
                         FontSize="18"
                         HorizontalAlignment="Stretch"/>
            </Grid>

            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0"
                         Text="Reboque"
                         Style="{StaticResource CaptionStyle}"
                         FontSize="10"
                         HorizontalAlignment="Center"/>
              <TextBlock Name="TrailerDamageText"
                         Grid.Row="1"
                         Text="0,0%"
                         Style="{StaticResource ValueStyle}"
                         FontSize="18"
                         HorizontalAlignment="Stretch"/>
            </Grid>

            <Grid Grid.Column="3">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0"
                         Text="Carga"
                         Style="{StaticResource CaptionStyle}"
                         FontSize="10"
                         HorizontalAlignment="Center"/>
              <TextBlock Name="CargoDamageText"
                         Grid.Row="1"
                         Text="0,0%"
                         Style="{StaticResource ValueStyle}"
                         FontSize="18"
                         HorizontalAlignment="Stretch"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <!-- Indicadores visuais no canto superior direito -->
    <StackPanel Grid.RowSpan="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,2,14,0"
                Panel.ZIndex="100">
      <Ellipse Width="6" Height="6" Fill="{StaticResource EdgeBrush}" Margin="2,0"/>
      <Ellipse Width="6" Height="6" Fill="{StaticResource EdgeBrush}" Margin="2,0"/>
      <Ellipse Width="6" Height="6" Fill="{StaticResource EdgeBrush}" Margin="2,0"/>
      <Ellipse Width="6" Height="6" Fill="{StaticResource EdgeBrush}" Margin="2,0"/>
    </StackPanel>
  </Grid>
</Window>